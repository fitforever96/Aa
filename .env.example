# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Enables AI writing, research, command parsing and document extraction.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=claude-opus-5-5
# Strongly recommended when deployed: a passcode the app must send to use AI routes.
# Enter the same value in Settings > AI & Research > Access passcode.
APP_ACCESS_TOKEN=
